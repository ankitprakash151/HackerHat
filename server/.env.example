# VibeShield Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration (Atlas or local)
MONGODB_URI=mongodb://localhost:27017/vibeshield

# JWT Secret for Authenticated Sessions
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars

# GitHub OAuth Credentials (for Repo Ownership Verification)
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Tool Execution Configuration
SEMGREP_PATH=semgrep
GITLEAKS_PATH=gitleaks
DOCKER_PATH=docker
ZAP_DOCKER_IMAGE=zaproxy/zap-baseline:stable

# Storage & Temporary Paths
TEMP_UPLOAD_DIR=./temp_uploads
REPORTS_STORAGE_DIR=./reports_storage

# Limits & Safety Watchdogs
DAST_TIMEOUT_MS=180000
MAX_UPLOAD_SIZE_BYTES=52428800
